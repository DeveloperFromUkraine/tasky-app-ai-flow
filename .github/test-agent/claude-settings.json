{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "Edit(backend/tests/**/*.test.ts)",
      "Edit(frontend/src/**/*.test.ts)",
      "Edit(frontend/src/**/*.test.tsx)",
      "Edit(.test-agent/decisions.json)",
      "Bash(node .test-agent/bin/run-tests.mjs *)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Agent",
      "Read(//proc/**)",
      "Read(~/**)",
      "Read(.git/**)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "disableBypassPermissionsMode": "disable"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}
